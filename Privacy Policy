<script type="text/javascript">
  function reloadForethoughtFresh(intentId) {
    console.log("Completely reloading Forethought with intent:", intentId);

    // Remove existing script
    const oldScript = document.getElementById("forethought-script");
    if (oldScript) {
      oldScript.remove();
      console.log("Removed existing Forethought script.");
    }

    // Remove the iframe completely (kills current session)
    const existingIframe = document.querySelector("iframe#forethought-chat, iframe[src*='solve-widget.forethought.ai']");
    if (existingIframe) {
      existingIframe.remove();
      console.log("Removed existing Forethought iframe.");
    }

    // Inject a fresh Forethought script with the specified intent
    const script = document.createElement("script");
    script.id = "forethought-script";
    script.src = "https://solve-widget.forethought.ai/embed.js";
    script.type = "application/javascript";
    script.setAttribute("data-api-key", "0918cbd1-1d49-40ab-acfb-43e82113e17d");
    script.setAttribute("data-ft-Embed-Script-Language", typeof FTLocale !== "undefined" ? FTLocale : "en");
    script.setAttribute("data-ft-Platform-String", "helpcenter");
    script.setAttribute("data-ft-currentUrl", window.location.hostname);
    script.setAttribute("initial-intent-id", intentId);
    script.setAttribute("data-ft-workflow-tag", "copyright");

    // Optional: force a fresh session and hide until ready
    script.setAttribute("config-ft-persistence-id", "report-abuse-" + Date.now());
    script.setAttribute("hidden", "true");

    document.head.appendChild(script);

    // Open the widget as soon as it loads
    window.addEventListener("message", function onLoad(event) {
      if (event.data?.event === "forethoughtWidgetLoaded") {
        window.removeEventListener("message", onLoad);
        console.log("Forethought fully loaded. Launching intent.");
        window.Forethought('widget', 'show');
        window.Forethought('widget', 'open');
      }
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    // Bind to your CTA
    document.querySelectorAll("[data-launch-chat]").forEach(function (element) {
      element.addEventListener("click", function (event) {
        event.preventDefault();
        reloadForethoughtFresh("67efa65b-ea2e-4ea9-a94c-be656ad73c68");
      });
    });

    //  Wufoo logic
    document.querySelectorAll("[data-launch-webform]").forEach(function (element) {
      var d = document,
          s = d.createElement('script'),
          h = element.getAttribute('data-launch-webform');
      if (!h) return;
      var options = {
        'userName': 'scribd', 'formHash': h,
        'autoResize': true, 'height': '3363', 'async': true,
        'host': 'wufoo.com', 'header': 'show', 'ssl': true
      };
      var wf;
      s.src = ('https:' == d.location.protocol ? 'https' : 'http') + '://secure.wufoo.com/scripts/embed/form.js';
      s.onload = s.onreadystatechange = function () {
        var rs = this.readyState;
        if (rs && rs !== 'complete' && rs !== 'loaded') return;
        try {
          wf = new WufooForm();
          wf.initialize(options);
          wf.display();
        } catch (e) { }
      };
      var scr = d.getElementsByTagName('script')[0],
          par = scr.parentNode;
      par.insertBefore(s, scr);
