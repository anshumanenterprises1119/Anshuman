# -----------------------------------------------------------------------------
# DEVELOPMENT ENVIRONMENT VARIABLES TEMPLATE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Local/Dev Database Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Fast2SMS Messaging Sandbox
FAST2SMS_API_KEY=your_fast2sms_api_key

# PhonePe Payment Gateway (Sandbox/Testing credentials)
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_MERCHANT_ID=PGTESTPAYUAT

# Cloudflare R2 Dev Storage Bucket
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=anshuman-commerce-dev

# Cookie and Storage Prefix Configuration
NEXT_PUBLIC_COOKIE_PREFIX=dev_
