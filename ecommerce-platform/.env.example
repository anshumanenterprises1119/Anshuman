# -----------------------------------------------------------------------------
# NEXT.JS STOREFRONT ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local (for local development) or configure in hosting provider
# -----------------------------------------------------------------------------

# Application Environment (production, staging, development)
NEXT_PUBLIC_APP_ENV=development

# Storefront URL Address
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE CONNECTION CREDENTIALS (REQUIRED)
# Retrieve from Supabase Console -> Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# PHONEPE UPI GATEWAY (REQUIRED)
# Retrieve from PhonePe Merchant portal. Use sandbox settings for local dev.
# -----------------------------------------------------------------------------
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_MERCHANT_ID=PGTESTPAYUAT

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 SECURE STORAGE (OPTIONAL)
# Retrieve from Cloudflare Console -> R2 Storage.
# If omitted, local disk storage fallbacks will be used.
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id-placeholder
R2_SECRET_ACCESS_KEY=your-secret-access-key-placeholder
R2_BUCKET_NAME=anshuman-commerce-prod

# -----------------------------------------------------------------------------
# SMS OTP ROUTING KEY (OPTIONAL - SET FOR PHONE PASSCODE SIGNUPS)
# Fast2SMS gateway key. Skip this if using free Email OTP authentication.
# -----------------------------------------------------------------------------
FAST2SMS_API_KEY=bPiL4tl6Mq0DTOSWux9spBhzGeFCfEAQIknHU25Jj7ZN3VRoywV5Bno60E9xf4LC7licqmWXsMbItwRk

# -----------------------------------------------------------------------------
# SESSION COOKIES ISOLATION PREFIX (REQUIRED)
# Use prod_, staging_, or dev_ depending on environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COOKIE_PREFIX=dev_
