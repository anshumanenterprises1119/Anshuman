# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.anshumanenterprises.com

# Supabase Production Database Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Fast2SMS Messaging Production API
FAST2SMS_API_KEY=your_fast2sms_api_key

# PhonePe Payment Gateway (Real production merchant)
PHONEPE_SALT_KEY=real_production_salt_key_placeholder
PHONEPE_SALT_INDEX=1
PHONEPE_MERCHANT_ID=PRODUCTION_MERCHANT_ID

# Cloudflare R2 Production Storage Bucket
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=anshuman-commerce-prod

# Cookie and Storage Prefix Configuration
NEXT_PUBLIC_COOKIE_PREFIX=prod_
